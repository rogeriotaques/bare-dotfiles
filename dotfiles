#!/usr/bin/env bash

# Define paths: bare git repo is hidden in ~/.dotfiles, work tree is $HOME
GIT_DIR="$HOME/.dotfiles"
WORK_TREE="$HOME"

# Helper function to run Git inside the bare repository
function git_config() {
    /usr/bin/git --git-dir="$GIT_DIR" --work-tree="$WORK_TREE" "$@"
}

# Slack incoming webhook URL, read from env or a private (untracked) file
SLACK_WEBHOOK_FILE="$HOME/.config/dotfiles/slack-webhook-url"
function slack_webhook_url() {
    if [ -n "$DOTFILES_SLACK_WEBHOOK" ]; then
        echo "$DOTFILES_SLACK_WEBHOOK"
    elif [ -r "$SLACK_WEBHOOK_FILE" ]; then
        head -n 1 "$SLACK_WEBHOOK_FILE" | tr -d '[:space:]'
    fi
}

function json_escape() {
    awk 'BEGIN { ORS = "" }
    {
        gsub(/\\/, "\\\\"); gsub(/"/, "\\\""); gsub(/\t/, "\\t"); gsub(/\r/, "")
        gsub(/[\001-\037]/, "")
        if (NR > 1) printf "\\n"
        print
    }'
}

# Post a message to Slack. Returns non-zero if no webhook is set or delivery fails.
function notify_slack() {
    local url payload status
    url=$(slack_webhook_url)
    [ -z "$url" ] && return 1
    payload="{\"text\":\"$(printf '%s' "$1" | json_escape)\"}"
    status=$(/usr/bin/curl -sS --max-time 15 -o /dev/null -w '%{http_code}' \
        -H 'Content-Type: application/json' -d "$payload" "$url" 2> /dev/null)
    [[ "$status" == 2* ]]
}

# Render tracked files as an indented tree, collapsing busy directories
function render_tree() {
    local expand="$1" threshold="$2"
    awk -v expand="$expand" -v threshold="$threshold" '
    {
        paths[NR] = $0
        total = NR
        n = split($0, parts, "/")
        dir = ""
        for (i = 1; i < n; i++) {
            dir = (dir == "" ? parts[i] : dir "/" parts[i])
            dir_count[dir]++
        }
    }
    END {
        for (i = 1; i <= total; i++) {
            n = split(paths[i], parts, "/")

            collapse_at = 0
            dir = ""
            for (j = 1; j < n; j++) {
                dir = (dir == "" ? parts[j] : dir "/" parts[j])
                if (expand != "true" && dir_count[dir] > threshold) {
                    collapse_at = j
                    break
                }
            }

            if (collapse_at > 0) {
                dir = ""
                for (j = 1; j <= collapse_at; j++) {
                    dir = (dir == "" ? parts[j] : dir "/" parts[j])
                }
                if (!(dir in shown)) {
                    shown[dir] = 1
                    indent = ""
                    for (j = 1; j < collapse_at; j++) indent = indent "  "
                    printf "%s%s/ (%d files)\n", indent, parts[collapse_at], dir_count[dir]
                }
            } else {
                dir = ""
                for (j = 1; j < n; j++) {
                    dir = (dir == "" ? parts[j] : dir "/" parts[j])
                    if (!(dir in shown)) {
                        shown[dir] = 1
                        indent = ""
                        for (k = 1; k < j; k++) indent = indent "  "
                        printf "%s%s/\n", indent, parts[j]
                    }
                }
                indent = ""
                for (j = 1; j < n; j++) indent = indent "  "
                printf "%s%s\n", indent, parts[n]
            }
        }
    }'
}

# Print clear usage guidelines
function show_help() {
    echo "Usage: dotfiles <command> [options]"
    echo ""
    echo "Commands:"
    echo "  init <remote_url>   Set up a bare repo at ~/.dotfiles and link a remote"
    echo "  restore <remote>    Clone and deploy your dotfiles on a fresh machine (with auto-backup)"
    echo "  add <files...>      Track files (e.g., dotfiles add .config/nvim/init.lua)"
    echo "  save [msg]          Commit and push (auto-generates message if omitted)"
    echo "  commit <msg>        Commit changes without pushing"
    echo "  push                Push commits up to your remote repository"
    echo "  list [--all]        List all tracked (backed up) files (tree view; --all expands everything)"
    echo "  status              Check which tracked files have changed"
    echo "  auto-sync           Check for changes and instantly commit/push (ideal for cron)"
    echo "  test-notify         Send a test failure notification to Slack"
    echo "  git <args...>       Pass any raw Git command directly to the bare repo"
}

case "$1" in
    init)
        if [ -z "$2" ]; then
            echo "Error: Remote repository URL required."
            exit 1
        fi
        echo "Creating bare Git repository at $GIT_DIR..."
        git init --bare "$GIT_DIR"
        git_config config --local status.showUntrackedFiles no
        git_config remote add origin "$2"
        git_config branch -M main
        echo "Initialization complete! Add files using: dotfiles add <file>"
        ;;

    restore)
        if [ -z "$2" ]; then
            echo "Error: Remote repository URL required to restore."
            exit 1
        fi

        echo "Preparing to restore dotfiles from $2..."
        echo ".dotfiles" >> "$HOME/.gitignore"

        /usr/bin/git clone --bare "$2" "$GIT_DIR"
        git_config config --local status.showUntrackedFiles no

        echo "Checking for local file conflicts..."
        CONFLICTS=$(git_config checkout 2>&1 | grep -E "^\s+" | awk '{print $1}')

        if [ -n "$CONFLICTS" ]; then
            BACKUP_DIR="$HOME/.dotfiles_backup_$(date +%Y%m%d_%H%M%S)"
            echo "⚠️ Found pre-existing files that conflict with your backup."
            echo "Moving conflicting files to safety at: $BACKUP_DIR"
            mkdir -p "$BACKUP_DIR"

            echo "$CONFLICTS" | while read -r FILE; do
                if [ -f "$HOME/$FILE" ] || [ -L "$HOME/$FILE" ]; then
                    mkdir -p "$BACKUP_DIR/$(dirname "$FILE")"
                    mv "$HOME/$FILE" "$BACKUP_DIR/$FILE"
                fi
            done
        fi

        echo "Deploying files into place..."
        git_config checkout -f
        echo "🎉 Dotfiles successfully deployed perfectly to your home directory!"
        ;;

    auto-sync)
        # Silent on success, so cron only sends mail when something fails.
        # Progress messages are shown only when run interactively.
        function say() { [ -t 1 ] && echo "$@"; return 0; }

        HOSTNAME=$(hostname)
        TIMESTAMP=$(date "+%Y-%m-%d %H:%M:%S")
        LOG=$(mktemp -t dotfiles-auto-sync)
        trap 'rm -f "$LOG"' EXIT

        # Report via Slack; fall back to stderr (cron's local mail) if Slack is unavailable
        function fail() {
            local summary="dotfiles auto-sync failed on $HOSTNAME at $TIMESTAMP: $1"
            local details
            details=$(tail -n 40 "$LOG")
            if ! notify_slack ":warning: *${summary}*"$'\n```\n'"${details}"$'\n```'; then
                { echo "$summary"; echo ""; echo "$details"; } >&2
            fi
            [ -t 1 ] && echo "$summary"
            exit 1
        }

        # Check if there are changes to already tracked files
        # (Since status.showUntrackedFiles is 'no', this safely ignores untracked clutter)
        git_config diff --quiet --exit-code > "$LOG" 2>&1
        case $? in
            0) say "No changes detected in tracked dotfiles. Exiting cleanly."; exit 0 ;;
            1) ;;
            *) fail "could not check for changes" ;;
        esac

        say "Changes detected! Preparing automated backup..."

        COMMIT_MSG="auto-sync: update from $HOSTNAME at $TIMESTAMP"

        git_config add -u > "$LOG" 2>&1 || fail "git add failed"
        git_config commit -m "$COMMIT_MSG" > "$LOG" 2>&1 || fail "git commit failed"

        CURRENT_BRANCH=$(git_config branch --show-current)
        say "Pushing changes to remote branch: $CURRENT_BRANCH..."
        git_config push origin "$CURRENT_BRANCH" > "$LOG" 2>&1 || fail "git push to $CURRENT_BRANCH failed"
        say "🎉 Auto-sync completed successfully!"
        ;;

    save)
        shift
        COMMIT_MSG="${1:-"dotfiles: update from $(hostname) at $(date '+%Y-%m-%d %H:%M:%S')"}"

        git_config add -u
        git_config commit -m "$COMMIT_MSG"

        CURRENT_BRANCH=$(git_config branch --show-current)
        git_config push origin "$CURRENT_BRANCH"
        echo "Dotfiles saved and pushed to $CURRENT_BRANCH!"
        ;;

    list)
        if ! git_config rev-parse HEAD > /dev/null 2>&1; then
            echo "No files tracked yet. Use: dotfiles add <file>"
            exit 0
        fi

        EXPAND_ALL=false
        [ "${2:-}" = "--all" ] && EXPAND_ALL=true

        /usr/bin/git -C "$WORK_TREE" --git-dir="$GIT_DIR" --work-tree="$WORK_TREE" ls-tree --name-only -r HEAD | render_tree "$EXPAND_ALL" 5
        ;;

    test-notify)
        if [ -z "$(slack_webhook_url)" ]; then
            echo "No Slack webhook configured. Save its URL to $SLACK_WEBHOOK_FILE"
            exit 1
        fi
        if notify_slack ":white_check_mark: dotfiles test notification from $(hostname)"; then
            echo "Test notification sent to Slack."
        else
            echo "Failed to deliver the Slack notification. Check the webhook URL."
            exit 1
        fi
        ;;

    add|commit|push|status)
        git_config "$@"
        ;;

    git)
        shift
        git_config "$@"
        ;;

    *)
        show_help
        ;;
esac

